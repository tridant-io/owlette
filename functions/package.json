{
  "name": "owlette-functions",
  "version": "1.0.0",
  "packageManager": "npm@10.9.0",
  "description": "Cloud Functions for Owlette dashboard",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "tsc --noEmit",
    "test": "tsc -p test/tsconfig.json && node --test lib-test/test/*.test.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "private": true,
  "overrides": {
    "protobufjs": "^7.5.5",
    "websocket-driver": "^0.7.5",
    "minimatch": "^11.0.1",
    "glob": "^14.0.2",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}

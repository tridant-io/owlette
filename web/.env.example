# Owlette web env template — copy to web/.env.local and fill in.
#
# scripts/env-manifest.json is the canonical registry of every key that belongs
# on a deployed target (railway-dev, railway-prod, vercel-prod) — this file is
# the local-dev mirror of it. `node scripts/sync-env.mjs` reports drift between
# the two. When you add a key here, add it to the manifest in the same change.
#
# A local dev server only needs the Firebase blocks, SESSION_SECRET and
# MFA_ENCRYPTION_KEY; everything else can stay unset until you need the feature.

# Firebase Client-Side Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps > Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Server-Side Admin SDK (Required for Agent OAuth Authentication)
# Get these values from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Download the JSON file and extract these values:
#   - project_id → FIREBASE_PROJECT_ID
#   - client_email → FIREBASE_CLIENT_EMAIL
#   - private_key → FIREBASE_PRIVATE_KEY (keep the \n escape sequences)

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----"

# Next.js
NODE_ENV=development
# Optional: comma-separated additional dev origins for Next.js, e.g. http://100.64.x.x:3000,http://localhost:3001
NEXT_ALLOWED_DEV_ORIGINS=

# Session Secret (Required for HTTPOnly cookie encryption)
# SECURITY: Generate a strong random secret with: openssl rand -base64 32
# IMPORTANT: Use different secrets for dev and production!
# Minimum length: 32 characters
SESSION_SECRET=your-super-secret-session-key-min-32-chars-here

# MFA Encryption Key (Required for encrypting 2FA secrets at rest)
# SECURITY: Generate a strong random secret with: openssl rand -base64 32
# IMPORTANT: Use different keys for dev and production!
# WARNING: Changing this key will invalidate all existing 2FA configurations!
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-min-32-chars-here

# Upstash Redis (Required for rate limiting)
# Create free account at https://upstash.com/
# Create Redis database and copy connection details
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Resend Email Service (for user notifications)
# Get API key from https://resend.com/api-keys
# Verified sender email from https://resend.com/domains

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Admin notification emails (separate for dev and prod)
ADMIN_EMAIL_DEV=admin-dev@example.com
ADMIN_EMAIL_PROD=admin@example.com

# Optional: Send welcome emails to new users (true/false)
SEND_WELCOME_EMAIL=false

# For cron job to check if agent is still alive
CRON_SECRET=random_string

# Shared secret to auth internal HTTP call from agent alert
# (/api/agent/alert) to Cortex endpoint (/api/cortex/autonomous)
CORTEX_INTERNAL_SECRET=random_string

# LLM Provider Key Encryption
# Required if storing LLM provider keys; falls back to MFA_ENCRYPTION_KEY if unset.
# Canonical doc: /docs/setup/environment-variables.md
# WARNING: Rotating this key invalidates existing encrypted LLM configs.
LLM_ENCRYPTION_KEY=your-llm-encryption-key-min-32-chars-here

# Public Base URL
# Public HTTPS origin used in email links and agent callbacks.
# Canonical doc: /docs/setup/environment-variables.md
NEXT_PUBLIC_BASE_URL=https://owlette.app

# R2 Artifact Uploads
# Cloudflare R2 S3-compatible endpoint URL required for roost version artifact uploads.
# Canonical doc: /docs/setup/environment-variables.md
R2_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com

# Instatus Status Page (optional)
# API token; only set if /api/cron/status-ping should publish to Instatus.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_API_KEY=your_instatus_api_token

# Instatus Page
# Hosted page id for status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_PAGE_ID=your_instatus_page_id

# Instatus API Base URL
# Optional override; defaults to https://api.instatus.com.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_API_BASE_URL=https://api.instatus.com

# Instatus Dashboard Component
# Component ID for dashboard status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_COMPONENT_DASHBOARD_ID=your_dashboard_component_id

# Instatus API Component
# Component ID for API status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_COMPONENT_API_ID=your_api_component_id

# Instatus Agent Registry Component
# Component ID for agent registry status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_COMPONENT_AGENT_REGISTRY_ID=your_agent_registry_component_id

# Instatus Webhook Delivery Component
# Component ID for webhook delivery status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_COMPONENT_WEBHOOK_DELIVERY_ID=your_webhook_delivery_component_id

# Instatus R2 Uploads Component
# Component ID for R2 uploads status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_COMPONENT_R2_UPLOADS_ID=your_r2_uploads_component_id

# Instatus Firestore Component
# Component ID for Firestore status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_COMPONENT_FIRESTORE_ID=your_firestore_component_id

# Instatus Cortex Chat Component
# Component ID for Cortex chat status-page tracking.
# Canonical doc: /docs/setup/environment-variables.md
INSTATUS_COMPONENT_CORTEX_CHAT_ID=your_cortex_chat_component_id

# Stripe Billing (optional — billing features stay dormant while unset)
# Get keys from https://dashboard.stripe.com/apikeys (Tridant account).
# STRIPE_SECRET_KEY is read first; STRIPE_SECRET_KEY_TEST is the fallback.
# Set exactly ONE of them per environment — test-mode locally and on dev.
STRIPE_SECRET_KEY_TEST=sk_test_xxxxxxxxxxxxxxxxxxxx

# Sentry Error Monitoring (optional — errors only reported when DSN is set)
# Get DSN from https://sentry.io > Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Source map upload (set in CI/Railway, not needed locally)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=owlette-web

# Cloudflare Turnstile (bot check on register + forgot-password)
# One widget serves owlette.app, dev.owlette.app and localhost — same sitekey
# and secret everywhere. TURNSTILE_SECRET is a must-match secret: if railway-prod
# and vercel-prod differ, failover breaks those two flows.
# TURNSTILE_HOSTNAMES is the per-deployment allowlist checked against the
# siteverify response — NEVER include localhost in a prod value.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET=0x0000000000000000000000000000000000
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# R2 Credentials (roost chunk + version uploads)
# S3-compatible access keys minted in the Cloudflare dashboard; the bucket and
# CORS themselves come from `node scripts/provision-r2.mjs`.
R2_S3_ACCESS_KEY_ID=your_r2_access_key_id
R2_S3_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Roost environment label (set on prod targets; selects the prod bucket prefix)
# ROOST_ENV=prod

# swoop (remote KVM) signaling + tokens
# SWOOP_JWT_PRIVATE_KEY, SWOOP_SESSION_MASTER_KEY and SWOOP_SIGNAL_RING_SECRET
# are must-match secrets — railway-prod and vercel-prod must carry identical
# values or tokens minted by the failover origin fail at the signaling worker.
SWOOP_SIGNAL_URL=https://swoop-signal.example.workers.dev
SWOOP_SIGNAL_RING_SECRET=your_ring_secret
SWOOP_JWT_KID=your_key_id
SWOOP_JWT_PRIVATE_KEY=your_eddsa_private_key
SWOOP_JWT_PUBLIC_KEY=your_eddsa_public_key
SWOOP_SESSION_MASTER_KEY=your_session_master_key

# Cloudflare TURN (swoop ICE credentials)
# The API token mints ICE credentials at rtc.live.cloudflare.com; it cannot read
# the GraphQL analytics API, so TURN usage metering needs its own token.
CLOUDFLARE_TURN_KEY_ID=your_turn_key_id
CLOUDFLARE_TURN_KEY_API_TOKEN=your_turn_api_token

# ---------------------------------------------------------------------------
# Optional overrides — every one of these has a working default. Set only when
# the comment's condition applies.
# ---------------------------------------------------------------------------

# App Check: stays inert until this reCAPTCHA Enterprise site key is set, and is
# always skipped against the emulator. Deliberately deferred — set it during the
# rollout in docs/runbooks/app-check-rollout.md, not before.
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Audit log: the recordAuditEvent URL is composed from FIREBASE_PROJECT_ID plus
# the region, which resolves on all targets. Override only if the function moves.
# AUDIT_LOG_REGION=us-central1
# AUDIT_LOG_URL=

# Screenshot storage bucket: server-side fallback after
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET, which is set on all targets, so it never fires.
# FIREBASE_STORAGE_BUCKET=

# Synthetic health checks: the origin they probe falls back to RAILWAY_PUBLIC_DOMAIN,
# which already resolves on both Railway services.
# OWLETTE_STATUS_BASE_URL=

# Stray alias read only as a health-check base-url fallback. NEXT_PUBLIC_BASE_URL
# above is the canonical public origin — prefer that.
# NEXT_PUBLIC_APP_URL=

# Instatus components with no page component yet — exempt from the readiness gate.
# INSTATUS_COMPONENT_ALERT_DELIVERY_ID=
# INSTATUS_COMPONENT_TALON_DISPATCH_ID=

# Instatus request shape: method defaults to PUT (PUT, PATCH or POST); the URL
# template takes {pageId} + {componentId} and defaults to the built-in path.
# INSTATUS_COMPONENT_STATUS_METHOD=PUT
# INSTATUS_COMPONENT_STATUS_URL_TEMPLATE=

# Dev-only toggles (railway-dev): rate limiting in observe (non-blocking) mode,
# and the security-boundary E2E drill switch.
# RATE_LIMIT_OBSERVE_ONLY=true
# SECURITY_BOUNDARY_SENTRY_METRICS=true

# Temporary security-drill marker (wave 8.1) — remove from Railway and the
# manifest when the drill is retired.
# W8_1_DRILL_TS=

# ---------------------------------------------------------------------------
# NEVER set these on a deployed target. They are inventoried in
# scripts/env-manifest.json under "never-set", and that omission is the guard:
# sync-env.mjs reports any of them found live as drift and `check` exits 1.
# Emulator hosts and OWLETTE_E2E belong to local/e2e runs only; the rest disable
# a security control (webhook https-only, rate limiting, capability enforcement,
# legacy API-key bypass).
#
#   ALLOW_INSECURE_WEBHOOK_URLS, E2E_DISABLE_RATE_LIMIT, OWLETTE_E2E,
#   ENABLE_CAPABILITY_ENFORCEMENT, ENABLE_RATE_LIMIT_ENFORCEMENT,
#   LEGACY_API_KEY_BYPASS_ENABLED, LEGACY_API_KEY_ALLOW_HASH_LIST,
#   GCLOUD_PROJECT, FIREBASE_AUTH_EMULATOR_HOST, FIRESTORE_EMULATOR_HOST,
#   NEXT_PUBLIC_USE_FIREBASE_EMULATOR, NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST,
#   NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST, NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST
# ---------------------------------------------------------------------------

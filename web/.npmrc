# set when @ai-sdk/react@3.x declared a react peer range that excluded the
# pinned react, so a clean `npm install` failed with ERESOLVE on platforms that
# re-resolve peers (Vercel, CI). react 19.3.1 is inside @ai-sdk/react 4's range,
# so that reason is gone; the flag stays until a clean `npm ci` without it is
# proven on Railway, Vercel and CI, whose install commands also pass it.
legacy-peer-deps=true

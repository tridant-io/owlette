# .claude environment overrides — copy to .claude/.env.local and fill in.
# This file documents what's expected; the actual values live in .env.local (gitignored).

# Owlette API keys. Mint from the dashboard: Admin > API Keys (superadmin-only).
# Format: owk_xxx
#   OWLETTE_API_KEY      — dev. Broad scopes; used for API reads against dev.
#   OWLETTE_API_KEY_PROD — prod. installer=*:write ONLY, so site/machine routes
#                          answer 403 scope_insufficient. Installer uploads only.
OWLETTE_API_KEY=owk_replace_with_your_dev_key
OWLETTE_API_KEY_PROD=owk_replace_with_your_prod_installer_key

# API base URLs. Read by .claude/hooks/post-push-installer.mjs, which picks one
# by branch (main -> prod), and by the API-verification workflow in CLAUDE.md.
OWLETTE_DEV_API_URL=https://dev.owlette.app
OWLETTE_PROD_API_URL=https://owlette.app

# Cloudflare R2 provisioning — read by scripts/provision-r2.mjs, which creates
# the roost buckets and their CORS. The token needs R2 edit rights on the account;
# the S3 access keys the app uses are separate (see web/.env.example).
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_API_TOKEN=your_r2_api_token

# Cloudflare account token — a SEPARATE token from the R2 one above, and the one
# most Cloudflare work here needs. Read by wrangler (infra/swoop-signal) and by
# the load-balancer terraform in infra/cloudflare, which has always needed it but
# never said so here.
# Scopes: account > Workers Scripts > Edit, account > Workers Durable Objects >
# Edit, and zone > Workers Routes > Edit on owlette.app — the last because
# wrangler.toml declares a custom domain per environment, and without it a deploy
# fails at the route AFTER the script has uploaded. The load balancer additionally
# needs zone > Load Balancers > Edit.
# The same value goes in the CLOUDFLARE_API_TOKEN repository secret for CI.
CLOUDFLARE_API_TOKEN=your_cloudflare_account_token

# Firebase service account — optional here. The migration scripts,
# scripts/check-membership-read-path.mjs and scripts/upload-cortex-cli.mjs read
# these from web/.env.local, .claude/.env.local and scripts/.env.local in turn,
# so set them in ONE of those files. Use scripts/.env.local when you need dev and
# prod side by side: it also accepts the _DEV / _PROD suffixed variants.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----"

# Live dev smoke (web/e2e-live, `npm run smoke:dev`) — read from this file by the
# suite's global setup on a FIRST run only, to store a hoot LLM key for the
# smoke-siteadmin account through the app's own endpoint; later runs ignore it.
# The suite's other credentials are files, not variables: the dev service
# account at agent/config/firebase-creds-dev.json (override: SMOKE_SA_PATH) and
# web/.env.local (override: SMOKE_ENV_FILE). See web/e2e-live/README.md.
SMOKE_LLM_API_KEY=sk-ant-replace_with_a_hoot_key_for_the_smoke_account

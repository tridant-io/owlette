rules_version = '2';

// Owlette Firestore Security Rules
// Version: 2.12.0 - a member row may carry machineIds: that member reaches only those
//                   machines (canAccessMachine) and nothing site-wide
//                   (canAccessWholeSite); 2.11.0 made webhook documents site-admin read
// Last Updated: 2026-11-04
//
// Security Model:
// - Global roles: superadmin (platform-wide) | everyone else (no implicit site privilege)
// - Per-site roles: owner | admin | member, held on sites/{siteId}/members/{uid}
// - Site access is membership: a global `admin` grants NOTHING on a site it has no row for
// - Superadmins reach every site by global role and hold no member rows
// - A member row may list machineIds: that member reaches only those machines, and
//   nothing site-wide
// - Agents use custom tokens (OAuth) with site-scoped permissions
// - Agents can ONLY access their assigned site and machine (strict isolation)
// - Trusted server APIs manage control-plane writes
// - Unauthenticated users can read installer_metadata (for public downloads)
//
// Key Features:
// - OAuth Authentication: Agents authenticate via custom tokens (no service accounts)
// - Scoped Permissions: Agents limited to their site_id + machine_id (from token claims)
// - Admin Panel: User management, site assignment, installer version management
// - Public Downloads: Anyone can download agent installers
// - Site Access: membership only — an ACTIVE `sites/{siteId}/members/{uid}`
//   row, or global superadmin. A global `admin` role grants NOTHING. A row
//   with machineIds reaches only those machines.
// - Command System: Bidirectional communication with agents
//
// Custom Token Claims (for agents):
// - role: 'agent' (identifies agent authentication)
// - site_id: 'site_xxx' (which site this agent belongs to - snake_case!)
// - machine_id: 'DESKTOP-001' (which machine this agent represents - snake_case!)
//
// IMPORTANT: Claim names must be snake_case (site_id, machine_id) NOT camelCase!
// Firebase custom token claims are used in security rules exactly as provided.

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is a platform superadmin (role='superadmin' in users collection)
    // Superadmins have god-mode access across all sites and platform-wide operations
    // (installer uploads, user role management, global settings, etc).
    function isSuperadmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Check if request is from a trusted server/admin token.
    // Admin SDK bypasses rules; this supports custom-token admin clients.
    function isServiceAccount() {
      return request.auth != null &&
             ('admin' in request.auth.token) &&
             request.auth.token.admin == true;
    }

    // Check if request is from OAuth-authenticated agent
    // Agents have custom token with claims: {role: 'agent', site_id: 'xxx', machine_id: 'yyy'}
    function isAgent() {
      return request.auth != null &&
             ('role' in request.auth.token) &&
             ('site_id' in request.auth.token) &&
             ('machine_id' in request.auth.token) &&
             request.auth.token.role == 'agent' &&
             request.auth.token.site_id is string &&
             request.auth.token.machine_id is string;
    }

    // Check the calling user is NOT soft-deleted.
    // Admin soft-deletes set `deletedAt` on users/{uid}; once set the user
    // must lose dashboard access immediately even if they still hold a
    // valid Firebase session token. Returns true when the user doc is
    // missing OR present-but-not-deleted (graceful handling for new users
    // who haven't bootstrapped a users/{uid} doc yet).
    function isNotDeletedUser() {
      return isAuthenticated() &&
             (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              !('deletedAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deletedAt == null);
    }

    // ============================================
    // Per-site membership
    // ============================================
    //
    // Membership is a DOCUMENT: `sites/{siteId}/members/{uid}`, holding
    // `{ uid, role: 'owner'|'admin'|'member', status: 'active', addedAt, addedBy }`.
    // It replaces two legacy fields — `sites/{siteId}.owner` and
    // `users/{uid}.sites[]` — which are no longer consulted anywhere in this file.
    //
    // DOCUMENT-ACCESS COST. Firestore bills every get()/exists() in a rule
    // evaluation, on reject as well as accept, and caps a single-document request
    // at 10 accesses (20 in a transaction). exists() and get() on the SAME path
    // count once. The site-access path costs 2:
    //
    //     users/{uid}                    1   isNotDeletedUser() and isSuperadmin()
    //                                        share it — same document
    //     sites/{siteId}/members/{uid}   1   isActiveMember() and siteMemberRole()
    //                                        share it — same document
    //
    // memberIsWholeSite() and memberHoldsMachine() read the same member document,
    // so per-machine reads still cost 2, and chat messages and stream 3.
    //
    // `get(sites/{siteId})` is deliberately GONE from the auth path: site access
    // no longer depends on reading the site document at all.
    //
    // Reading `users/{uid}` is not the cheapest shape available — membership alone
    // would cost 1 — but it is what enforces soft-delete IMMEDIATELY. An
    // admin-disabled user has to lose access while still holding a live session
    // token, and their member rows survive until the delete cascade removes them.
    // Drop the user read only once that cascade is the enforcement point.

    function isActiveMember(siteId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/sites/$(siteId)/members/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/sites/$(siteId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // Per-site role. Only call behind isActiveMember(): get() on a missing
    // document returns null, and the field access would abort the evaluation.
    function siteMemberRole(siteId) {
      return get(/databases/$(database)/documents/sites/$(siteId)/members/$(request.auth.uid)).data.role;
    }

    // NOTE: there is deliberately no `isSiteOwner()` helper. Nothing in this file
    // gates on ownership — site create/update/delete are `isServiceAccount()`, so
    // ownership is enforced server-side where the transaction lives. The old
    // helper existed only because `canAccessSite` delegated to it; keeping an
    // uncalled one would read as a live, tested guard when no rule exercises it.
    // Ownership is `siteMemberRole(siteId) == 'owner'` if a rule ever needs it.

    // Check if agent has access to a specific site
    // Agents can ONLY access their assigned site (from token claim)
    function agentCanAccessSite(siteId) {
      return isAgent() && request.auth.token.site_id == siteId;
    }

    // Check if agent is accessing their own machine
    // Prevents agents from accessing other machines (even in same site)
    function agentCanAccessMachine(siteId, machineId) {
      return isAgent() &&
             request.auth.token.site_id == siteId &&
             request.auth.token.machine_id == machineId;
    }

    // canAccessSite admits a machine-scoped member. it gates only documents that say nothing
    // about other machines: the site document, settings/{swoop,display,cortex}, and the
    // schedule and reboot presets. a block that spans machines takes canAccessWholeSite; a
    // block under one machine takes canAccessMachine. a new block written with canAccessSite
    // hands every scoped member the whole collection.
    //
    // Check if user has access to a site.
    // Access is granted to:
    //   - superadmins (platform god-mode — every site, holding no member rows)
    //   - any user with an ACTIVE membership document for the site
    // Soft-deleted users (users/{uid}.deletedAt != null) are denied: admin
    // disables are immediately enforced even while a session token is still valid.
    //
    // Superadmins are deliberately NOT members. They reach every site by global
    // role, so writing them member rows would leave a demoted superadmin holding
    // grants nobody issued — which is why the short-circuit is here and not a
    // membership row. Their OWNERSHIP of a site is separate and is a member row.
    function canAccessSite(siteId) {
      return isAuthenticated() &&
             isNotDeletedUser() &&
             (isSuperadmin() || isActiveMember(siteId));
    }

    // Check if user is a site-scoped admin for a given site.
    // `admin` is now a PER-SITE role read from the membership document — a global
    // `users/{uid}.role == 'admin'` carries NO site privilege here. Owners rank
    // above admins and satisfy this too.
    // Use this for site-level elevated operations (delete machines, edit stored
    // layouts, manage site-scoped webhooks / settings) — as opposed to
    // isSuperadmin(), which is reserved for platform-wide operations.
    function isSiteAdmin(siteId) {
      return isAuthenticated() &&
             isNotDeletedUser() &&
             (isSuperadmin() ||
              (isActiveMember(siteId) &&
               siteMemberRole(siteId) in ['owner', 'admin'] &&
               memberIsWholeSite(siteId)));
    }

    // ---- machine scope (2.12.0) ----
    // a member row may carry machineIds: [<machineId>, ...]. absent = whole site (every row
    // before 2.12.0, every owner). present = only those machines and nothing site-wide.
    // fails closed: [] reaches nothing, and a value that is not a list (a map, a string,
    // null) reaches nothing either. `in` alone would test a map's keys. widening is a
    // field delete, never null. both helpers read the member document isActiveMember()
    // already reads, so no access is added. call them only behind isActiveMember(siteId).
    function memberIsWholeSite(siteId) {
      return !('machineIds' in get(/databases/$(database)/documents/sites/$(siteId)/members/$(request.auth.uid)).data);
    }
    function memberHoldsMachine(siteId, machineId) {
      return get(/databases/$(database)/documents/sites/$(siteId)/members/$(request.auth.uid)).data.machineIds is list &&
             machineId in get(/databases/$(database)/documents/sites/$(siteId)/members/$(request.auth.uid)).data.machineIds;
    }
    // site-wide reach: every collection that spans machines.
    function canAccessWholeSite(siteId) {
      return isAuthenticated() && isNotDeletedUser() &&
             (isSuperadmin() || (isActiveMember(siteId) && memberIsWholeSite(siteId)));
    }
    // one machine. rules are not filters: a list is provable only when the query pins the
    // id (documentId() ==/in, or a machineId field ==/in) to values all in the scope.
    function canAccessMachine(siteId, machineId) {
      return isAuthenticated() && isNotDeletedUser() &&
             (isSuperadmin() ||
              (isActiveMember(siteId) &&
               (memberIsWholeSite(siteId) || memberHoldsMachine(siteId, machineId))));
    }

    // Validate that required fields are present in write operations
    function hasRequiredFields(required) {
      return request.resource.data.keys().hasAll(required);
    }

    // ============================================
    // Retired Site IDs
    // ============================================

    match /site_ids/{siteId} {
      // Tombstones for deleted sites. Site ids are caller-supplied slugs, and
      // deleteSite clears `users/{uid}.sites[]` only for members whose user
      // document still exists — a stale entry can outlive the delete on a
      // hard-deleted or non-member account, so reusing a slug could still hand
      // the new site's data to a leftover holder. createSite refuses any id
      // with a tombstone.
      //
      // GET only, never LIST: the availability check is a single-document read
      // (hooks/useFirestore.ts). `allow read: if isAuthenticated()` would also
      // permit a collection query, since the condition binds neither `resource`
      // nor the wildcard — that would let any signed-in user enumerate every
      // deleted site slug in the fleet, which live sites do not allow
      // (`sites/{siteId}` is gated on canAccessSite). The document holds a
      // timestamp and nothing else; the deleting principal is in the platform
      // audit row, not here.
      // WRITE: trusted server APIs only.
      allow get: if isAuthenticated();
      allow list: if false;
      allow write: if isServiceAccount();
    }

    // ============================================
    // Site Membership (recursive — this is what enables collectionGroup)
    // ============================================

    // A `collectionGroup('members')` query is authorized ONLY by a rule matched at
    // a RECURSIVE wildcard path. A rule nested under `match /sites/{siteId}` does
    // not authorize one, however permissive it is. This block is what makes the
    // client's `collectionGroup('members').where('uid','==',me)` listener legal.
    //
    // WHY THIS IS NOT A REPEAT OF THE 1756e5f REGRESSION. An earlier
    // collectionGroup listener was removed because its rule matched `{siteId}` as
    // an UNCONSTRAINED path wildcard, so the query was authorized across every
    // site regardless of who asked. It was NOT removed for using `get()`. Here
    // both disjuncts bind the caller's own uid, so widening the path grants
    // nothing wider — the caller still reaches only their own rows.
    //
    // TWO DISJUNCTS, because get and list prove themselves differently:
    //   - `request.auth.uid == memberUid` covers a single-document get at ZERO
    //     document-access cost: the document id IS the member's uid.
    //   - `resource.data.uid == request.auth.uid` is what a LIST can prove.
    //     Firestore authorizes a query only when the query's own constraints
    //     guarantee the rule, and it cannot know the document id equals the `uid`
    //     field. `where('uid','==',me)` matches this term exactly — which is why
    //     MemberDoc duplicates uid as a field rather than relying on the id.
    //
    // A site's own members are NOT listable by other members: reading the roster
    // goes through the API, which applies SITE_MEMBER_MANAGE. Writes are
    // server-only — `membership.server.ts` is the single writer.
    //
    // SCOPE: the recursive wildcard matches ANY collection named `members` at any
    // depth, not only `sites/{siteId}/members`. That is the only one today. A new
    // one added elsewhere inherits self-read plus server-only writes, which is a
    // safe default rather than an accidental grant — but it inherits silently, so
    // check this block before naming another collection `members`.
    match /{path=**}/members/{memberUid} {
      allow get: if isAuthenticated() &&
                    (request.auth.uid == memberUid ||
                     (resource != null && resource.data.uid == request.auth.uid) ||
                     isServiceAccount());
      allow list: if isAuthenticated() &&
                     ((resource != null && resource.data.uid == request.auth.uid) ||
                      isServiceAccount());
      allow write: if isServiceAccount();
    }

    // ============================================
    // Sites Collection
    // ============================================

    match /sites/{siteId} {
      // Site document access
      // READ: site members and superadmins ONLY (canAccessSite). NOT any
      //   authenticated user — the id-availability check during site creation
      //   reads `site_ids/{siteId}` instead (see that block), precisely so this
      //   collection is not enumerable fleet-wide. The comment here used to say
      //   the opposite, which would have talked a reader into reopening it.
      // WRITE: trusted server APIs only
      allow read: if canAccessSite(siteId);
      allow create, update, delete: if isServiceAccount();

      // ----------------------------------------
      // Machines Subcollection
      // ----------------------------------------

      match /machines/{machineId} {
        // Machine status document
        // Agents write heartbeats, metrics, and process status
        // Web dashboard reads machine status; control-plane writes go through API routes
        // OAuth agents can ONLY access their own machine (strict isolation)
        allow read: if canAccessMachine(siteId, machineId) ||
                       isServiceAccount() ||
                       agentCanAccessMachine(siteId, machineId);

        // Allow agents full write access for metrics, heartbeats, processes.
        // Control-plane toggles (configChangeFlag, cortexEnabled, commands)
        // are server-mediated through API routes.
        allow update: if isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);

        // Allow agents full write access for metrics, heartbeats, processes
        allow write: if isServiceAccount() ||
                        agentCanAccessMachine(siteId, machineId);

        allow delete: if isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);

        // Commands documents (pending/completed)
        // Server APIs write pending commands
        // Agents read pending and write completed
        // OAuth agents can ONLY access commands for their own machine
        match /commands/{commandDoc} {
          allow read: if canAccessMachine(siteId, machineId) ||
                         isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);
          allow write: if isServiceAccount() ||
                          agentCanAccessMachine(siteId, machineId);
          allow delete: if isServiceAccount() ||
                           agentCanAccessMachine(siteId, machineId);
        }

        // Screenshot History Subcollection
        // Server-side API writes history entries (admin SDK bypasses rules)
        // Web dashboard reads to display screenshot history gallery
        match /screenshots/{screenshotId} {
          allow read: if canAccessMachine(siteId, machineId) ||
                         isServiceAccount();
        }

        // Installed Software Inventory Subcollection
        // Agents write software inventory data
        // Web dashboard reads to display installed software
        // OAuth agents can ONLY write to their own machine's inventory
        match /installed_software/{softwareId} {
          allow read: if canAccessMachine(siteId, machineId) ||
                         isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);
          allow write: if isServiceAccount() ||
                          agentCanAccessMachine(siteId, machineId); // Only agents can write inventory
          allow delete: if canAccessMachine(siteId, machineId) ||
                           isServiceAccount() ||
                           agentCanAccessMachine(siteId, machineId); // Allow cleanup
        }

        // ----------------------------------------
        // Hardware Profile Subcollection
        // ----------------------------------------
        // Stores hardware inventory/profile data for the machine
        // Agents write hardware profile on startup and on hardware changes
        // Web dashboard reads to display hardware details
        // OAuth agents can ONLY write to their own machine's hardware profile
        match /hardware/{docId} {
          allow read: if canAccessMachine(siteId, machineId) ||
                         isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);
          allow write: if isServiceAccount() ||
                          agentCanAccessMachine(siteId, machineId);
        }

        // ----------------------------------------
        // Cortex Subcollection (per-machine chat state)
        // ----------------------------------------
        // Holds the per-machine active-chat doc that the local Cortex
        // process polls + streams responses into (see
        // agent/src/cortex_firestore.py). The web dashboard reads it to
        // render the chat panel; the agent writes status / response chunks.
        // OAuth agents can ONLY access their own machine's cortex docs.
        match /cortex/{docId} {
          allow read: if canAccessMachine(siteId, machineId) ||
                         isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);
          allow write: if isServiceAccount() ||
                          agentCanAccessMachine(siteId, machineId);
        }

        // ----------------------------------------
        // Per-Machine Logs Subcollection
        // ----------------------------------------
        // Distinct from sites/{siteId}/logs/{logId} (site-scoped event
        // logs). This collection captures per-machine log shipping from
        // firebase_client._ship_log_entries — verbose process / service
        // output that's filtered per machine for the dashboard's log view.
        // Agents append-only; deletion / retention is server-mediated.
        match /logs/{logId} {
          allow read: if canAccessMachine(siteId, machineId) ||
                         isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);
          allow create: if isServiceAccount() ||
                           agentCanAccessMachine(siteId, machineId);
          allow update, delete: if isServiceAccount();
        }

        // ----------------------------------------
        // Historical Metrics Subcollection
        // ----------------------------------------
        // Stores time-series metrics for dashboard graphs
        // Daily buckets: metrics_history/{YYYY-MM-DD}
        // Fields: samples[] array with {t, c, m, d, g, ct, gt}
        // Retention: 1min (today) -> 10min (week) -> 20min (month) -> 1hr (forever)

        match /metrics_history/{bucketId} {
          // Web dashboard reads historical metrics for charts
          allow read: if canAccessMachine(siteId, machineId) ||
                         isServiceAccount() ||
                         agentCanAccessMachine(siteId, machineId);

          // Agents write metrics samples (append to daily bucket)
          allow write: if isServiceAccount() ||
                          agentCanAccessMachine(siteId, machineId);

          // Cloud Functions need to aggregate and update buckets
          // Service account has full access for aggregation jobs
          allow update: if isServiceAccount() ||
                           agentCanAccessMachine(siteId, machineId);
        }
      }

      // ----------------------------------------
      // Deployments Subcollection
      // ----------------------------------------

      match /deployments/{deploymentId} {
        // Software installation deployments
        // Server APIs create and manage deployments
        allow read: if canAccessWholeSite(siteId);
        allow create, update, delete: if isServiceAccount();
      }

      // ----------------------------------------
      // Installer Templates Subcollection
      // ----------------------------------------

      match /installer_templates/{templateId} {
        // Reusable installer templates
        // Server APIs manage templates
        allow read: if canAccessWholeSite(siteId);
        allow create, update, delete: if isServiceAccount();
      }

      // ----------------------------------------
      // Project Templates Subcollection
      // ----------------------------------------

      match /project_templates/{templateId} {
        // Reusable project distribution templates
        // Server APIs manage templates
        allow read: if canAccessWholeSite(siteId);
        allow create, update, delete: if isServiceAccount();
      }

      // ----------------------------------------
      // Roosts Subcollection (roost / v2)
      // ----------------------------------------
      // The only distribution system. The v1 `project_distributions` block was
      // removed in rules 2.9.0 — existing docs stay at rest but are no longer
      // readable or writable through any rule.
      //
      // Each roost represents a project kept in sync with one or more machines.
      // The doc itself stores ONLY the version pointer (currentVersionId,
      // previousVersionId, versionUrl) plus targets[] + metadata.
      // Version bodies themselves live in R2 (size: a 500GB project ~10MB
      // body, well over Firestore's 1MB doc limit).
      // schemaVersion: 2 distinguishes from v1 project_distributions.
      //
      // The old `*Manifest*` field names (currentManifestId, etc.) are
      // also blocked as defense-in-depth: legacy roost docs predate the
      // manifest->version rename and may still carry those keys, so the
      // immutability guard covers both names.

      match /roosts/{roostId} {
        allow read: if canAccessWholeSite(siteId);
        // WRITE: trusted server APIs only.
        //
        // These three were previously `canAccessSite(siteId)` — membership with
        // no role term — while the API gates the same operations on
        // DISTRIBUTION_MANAGE (site admin). A plain member could therefore
        // create and delete roosts straight from the client SDK, bypassing the
        // capability model entirely. The old create/update conditions guarded
        // the pointer fields (currentVersionId, versionUrl and the legacy
        // manifest names) against a forged "v0" pointing at attacker-controlled
        // storage, but they said nothing about WHO could write.
        //
        // Nothing in the app writes these documents from a client: every roost
        // mutation goes through /api/roosts/** under the admin SDK, and
        // hooks/useRoosts.ts holds a read-only listener. So this is server-only
        // rather than isSiteAdmin(siteId) — a stronger rule at no cost, and it
        // avoids re-deriving site-admin here at all. (isSiteAdmin is per-site
        // membership, owner|admin — a self-serve owner DOES satisfy it. The
        // note here predated per-site roles and said the reverse.)
        allow create, update, delete: if isServiceAccount();

        // ------------------------------------------
        // Per-target reported state (one doc per machine)
        // ------------------------------------------
        // Agents write their own observed state here so the dashboard can
        // show "machine X is ON version Y" vs the intended currentVersionId.
        // This closes the loop between intent (set by web) and reality
        // (reported by agent).

        match /target_state/{machineId} {
          // READ: any whole-site member can see reported target state.
          allow read: if canAccessWholeSite(siteId);
          // CREATE/UPDATE: ONLY the agent for this specific machine. Web
          // users cannot spoof an agent's reported state (would let a
          // malicious teammate hide pending rollouts by marking a machine
          // as already-synced when it isn't).
          allow create, update: if isAgent() &&
                                  request.auth.token.site_id == siteId &&
                                  request.auth.token.machine_id == machineId;
          // DELETE: whole-site members can clear stale state (manual cleanup
          // when an agent is decommissioned). Agents do not delete their
          // own state — they update it.
          allow delete: if canAccessWholeSite(siteId);
        }

        // ------------------------------------------
        // Manifest history (immutable)
        // ------------------------------------------
        // Each finalized manifest is recorded here for the rollback UI.
        // The manifest CONTENT lives in R2; this collection just holds
        // metadata + the R2 url + timestamps + author for the version
        // history dropdown.

        match /versions/{versionId} {
          // READ: any whole-site member can list version history (for rollback ui).
          allow read: if canAccessWholeSite(siteId);
          // CREATE: forbidden client-side. Versions are written ONLY by
          // /api/roosts/.../versions using the admin SDK, after the
          // chunk-presence check + r2 version body upload + transactional
          // pointer flip on the parent. Allowing client-side create would
          // let a site member publish a fake history entry pointing at
          // attacker-controlled storage (versionUrl is unvalidated).
          allow create: if false;
          // UPDATE/DELETE: history is immutable. Rollback works by
          // repointing currentVersionId on the parent roosts
          // doc, NOT by editing or deleting versions here. GC is admin
          // SDK only (bypasses these rules) and tombstone-protected.
          allow update: if false;
          allow delete: if false;
        }
      }

      // ----------------------------------------
      // Webhooks Subcollection
      // ----------------------------------------

      match /webhooks/{webhookId} {
        // Webhook notification endpoints — url, events, counters and rotation.
        //
        // READ is SITE-ADMIN, not site access. The comment here used to say the
        // signing secret was never in this document, and the code says otherwise:
        // `webhookSender.server.ts` still falls back to an in-document `secret` /
        // `signingSecret` for subscriptions predating the move to
        // `webhook_secrets`, and dev still holds two such documents because that
        // migration never ran. A plain member reading one gets the HMAC key and
        // can forge deliveries the customer's receiver validates as authentic —
        // and keeps that key after being removed from the site.
        //
        // Site-admin costs nothing here: webhooks are authored under
        // WEBHOOK_MANAGE, which is site-admin, and the only client that reads
        // them is the admin webhooks page. This closes the exposure whether or
        // not the secret migration has run, which a data fix alone cannot.
        // WRITE: trusted server APIs only.
        allow read: if isSiteAdmin(siteId);
        allow write: if isServiceAccount();
      }

      match /webhook_secrets/{webhookId} {
        // Webhook signing secrets — server-only, following the talon_secrets
        // pattern. They previously lived on the webhook document above, whose
        // read rule is canAccessSite(): every site MEMBER could read the HMAC
        // secret and forge deliveries the receiver would accept as authentic.
        // The comment on talon_secrets named that leak; this is it closed.
        //
        // Not even isSiteAdmin(): nothing client-side needs these. A secret is
        // returned exactly once, in the create and rotate API responses.
        allow read: if false;
        allow write: if false;
      }

      // ----------------------------------------
      // Logs Subcollection
      // ----------------------------------------

      match /logs/{logId} {
        // Event logs (process starts, crashes, kills, commands)
        // Agents write logs when events occur
        // Web dashboard reads logs for monitoring
        // Users can read logs for their sites. Agents and trusted server APIs
        // write logs; clearing logs is server-mediated.
        // a scoped member reads only their machines' rows, so their list must pin
        // machineId (== or in). a row without a machineId is whole-site only.
        allow read: if canAccessMachine(siteId, resource.data.machineId) ||
                       isServiceAccount() ||
                       agentCanAccessSite(siteId);
        allow create: if (isServiceAccount() ||
                          agentCanAccessSite(siteId)) &&
                         hasRequiredFields(['timestamp', 'action', 'level', 'machineId']) &&
                         (!isAgent() || request.resource.data.machineId == request.auth.token.machine_id);
        allow delete: if isServiceAccount();
      }

      // ----------------------------------------
      // Cortex Events Subcollection (site-scoped)
      // ----------------------------------------
      // Autonomous-investigation event log written by the local Cortex
      // process (see agent/src/cortex_firestore.write_autonomous_event).
      // Site-scoped (not machine-scoped) because the dashboard cross-cuts
      // events across every machine in a site for the activity feed.
      // Agents can only create events for their own site (token claim).
      // Updates / deletes are server-mediated.
      match /cortex-events/{eventId} {
        allow read: if canAccessWholeSite(siteId) ||
                       isServiceAccount();

        // Create: agent must claim its own machineId on the doc (or omit
        // it entirely — server-mediated paths set machineId via admin
        // SDK and bypass rules). Previously the rule only checked
        // site_id, which let an agent for machine A write events
        // claiming to be machine B in the same site.
        allow create: if isServiceAccount() ||
                         (isAgent() &&
                          request.auth.token.site_id == siteId &&
                          (!('machineId' in request.resource.data) ||
                           request.resource.data.machineId == request.auth.token.machine_id));

        // Update: agents need to update events they created (mark
        // resolved/escalated/failed, set escalation flags). Previously
        // updates were server-only, so the agent's status-update writes
        // were silently denied and events got stuck at initial status.
        // Constraints:
        //   - calling machine must match the existing event's machineId
        //   - machineId must NOT change on update (no reassignment)
        allow update: if isServiceAccount() ||
                         (isAgent() &&
                          request.auth.token.site_id == siteId &&
                          resource.data.machineId == request.auth.token.machine_id &&
                          request.resource.data.machineId == resource.data.machineId);

        // Delete is still server-mediated only.
        allow delete: if isServiceAccount();
      }

      // ----------------------------------------
      // Audit Log Subcollection
      // ----------------------------------------

      match /audit_log/{entryId} {
        // Audit entries are written by server APIs. Site admins can inspect
        // their site's audit trail; superadmins pass through isSiteAdmin().
        allow read: if isSiteAdmin(siteId);
        allow write: if false;
      }

      // ----------------------------------------
      // Talons Subcollections (automation)
      // ----------------------------------------
      // Talon definitions, their run history, and the webhook signing
      // secrets that back webhook outputs. Every write is server-mediated
      // (admin SDK via /api/sites/{siteId}/talons* and the /api/cron/talons
      // sweep, both of which bypass these rules) — clients never write
      // directly, so trigger/output validation, capability checks, and the
      // transactional nextRunAt claim can't be sidestepped.

      match /talons/{talonId} {
        // READ: any whole-site member can list/inspect talons for the site.
        // WRITE: server APIs only (admin SDK bypasses rules).
        allow read: if canAccessWholeSite(siteId);
        allow write: if false;
      }

      match /talon_runs/{runId} {
        // READ: any whole-site member can review run history.
        // WRITE: written only by the runner (admin SDK); run records are
        // an audit surface and must not be client-editable.
        allow read: if canAccessWholeSite(siteId);
        allow write: if false;
      }

      match /talon_secrets/{secretId} {
        // Webhook signing secrets are server-only by design. (The webhooks
        // block above is isSiteAdmin-read and its secrets moved to
        // `webhook_secrets` with read:false in rules 2.11.0 — this used to warn
        // against repeating a leak that no longer exists.)
        allow read: if false;
        allow write: if false;
      }
    }

    // ============================================
    // Config Collection
    // ============================================

    match /config/{siteId}/machines/{machineId} {
      // Machine configuration (process lists, settings)
      // Server APIs write config updates
      // Agents read config and write initial config on first startup
      // OAuth agents can ONLY access config for their own machine
      allow read: if canAccessMachine(siteId, machineId) ||
                     isServiceAccount() ||
                     agentCanAccessMachine(siteId, machineId);
      allow write: if isServiceAccount() ||
                      agentCanAccessMachine(siteId, machineId);
      allow delete: if isServiceAccount() ||
                       agentCanAccessMachine(siteId, machineId);
    }

    match /config/{siteId}/schedule_presets/{presetId} {
      // Schedule presets for process scheduling
      // Users with site access can read presets; server APIs manage them
      allow read: if canAccessSite(siteId);
      allow write, delete: if isServiceAccount();
    }

    match /config/{siteId}/reboot_presets/{presetId} {
      // Reboot schedule presets shared across machines in a site
      // Users with site access can read presets; server APIs manage them
      allow read: if canAccessSite(siteId);
      allow write, delete: if isServiceAccount();
    }

    match /config/{siteId}/project_distribution_presets/{presetId} {
      // Project distribution presets shared across a site
      // Users with whole-site access can read presets; server APIs manage them
      allow read: if canAccessWholeSite(siteId);
      allow write, delete: if isServiceAccount();
    }

    match /config/{siteId}/talon_presets/{presetId} {
      // Reusable talon templates shared across a site
      // Users with whole-site access can read presets; server APIs manage them
      allow read: if canAccessWholeSite(siteId);
      allow write, delete: if isServiceAccount();
    }

    // ============================================
    // Users Collection (Admin System)
    // ============================================

    match /users/{userId} {
      // User profiles with role and site access
      // Users can read their own document
      // Superadmins can read all user documents; writes are server-mediated
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin());

      // Users can create their own document (on first login).
      // Every sensitive field is pinned to a safe default — privilege /
      // identity elevation MUST go through a trusted server path
      // (isServiceAccount). Without these guards, a newly-signed-up user
      // could write `role: 'superadmin'`, `sites: ['victim-site']`,
      // `email: 'admin@owlette.app'`, or `mfaEnrolled: false` and either
      // own the platform or sidestep MFA on self-bootstrap.
      //
      // Each clause uses the absent-OR-equals pattern so the server can
      // omit the field at create time while still blocking client-supplied
      // alternate values.
      allow create: if request.auth.uid == userId &&
                       (!('role' in request.resource.data) ||
                        request.resource.data.role == 'member') &&
                       (!('sites' in request.resource.data) ||
                        request.resource.data.sites == []) &&
                       (!('email' in request.resource.data) ||
                        request.resource.data.email == request.auth.token.email) &&
                       (!('mfaEnrolled' in request.resource.data) ||
                        request.resource.data.mfaEnrolled == false) &&
                       (!('requiresMfaSetup' in request.resource.data) ||
                        request.resource.data.requiresMfaSetup == true);

      // Self-update is restricted to an explicit allowlist of safe profile
      // fields. Sensitive fields (role, email, sites, MFA state, passkey
      // state, secrets) MUST go through a trusted server path so a user
      // with a session token cannot e.g. disable their own MFA from the
      // browser console.
      //
      // diff().affectedKeys() returns only the keys whose values changed
      // between resource.data and request.resource.data, so a no-op write
      // that re-sends the entire user doc with the same values is allowed
      // (only changed keys appear in the affectedKeys set).
      allow update: if request.auth.uid == userId &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly([
                           'preferences',
                           'displayName',
                           'photoURL',
                           'timezone',
                           'lastSiteId',
                           'lastMachineIds'
                         ]);

      // Trusted server APIs manage user roles, site assignments, and deletion.
      allow write: if isServiceAccount();
    }

    // ============================================
    // Installer Metadata Collection (Admin System)
    // ============================================

    match /installer_metadata/{document=**} {
      // Agent installer versions and metadata
      // PUBLIC READ: Anyone can download installers (unauthenticated allowed)
      // ADMIN WRITE: trusted server APIs upload/modify installer versions
      allow read: if true;  // Public read for download button
      allow write: if isServiceAccount();
    }

    // ============================================
    // System Presets Collection
    // ============================================

    match /system_presets/{presetId} {
      // Global software deployment presets (Owlette Agent, TouchDesigner, etc.)
      // READ: All authenticated users can see presets
      // WRITE: trusted server APIs create/update/delete presets
      allow read: if isAuthenticated();

      // Platform-level presets are managed through server routes.
      allow create: if isServiceAccount();

      // Update and delete: trusted server APIs only
      allow update, delete: if isServiceAccount();
    }

    // ============================================
    // API Keys Subcollection
    // ============================================

    match /users/{userId}/api_keys/{keyId} {
      // Users can read their own key inventory (for settings UI).
      // Fields stored: name, keyPrefix, environment, scopes, expiresAt,
      // createdAt, lastUsedAt, rotatedAt, revokedAt (never the raw key or hash).
      // Writes are admin-SDK-only (route handlers) — client writes denied.
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // Top-level api_keys lookup table (keyHash → userId + keyId + scopes).
    // Never accessible client-side — admin SDK only.
    match /api_keys/{keyHash} {
      allow read, write: if false;
    }

    // ============================================
    // User Settings Subcollection
    // ============================================

    match /users/{userId}/settings/{settingId} {
      // User-level settings (e.g., LLM API keys)
      // Users can only read/write their own settings
      // Admin SDK handles encryption server-side
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId}/devicePrefs/{docId} {
      // Per-device UI preferences (e.g., view mode, collapse state)
      // Users can only read/write their own device preferences
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // Site Settings Subcollection
    // ============================================

    match /sites/{siteId}/settings/{settingId} {
      // Site-level settings (e.g., shared LLM API keys)
      // Trusted server APIs manage site-level settings
      // Regular users can read (to check if site key exists)
      // a scoped member still reads swoop, display and cortex: useSwoopSettings reads
      // a denial as enabled:false, which would hide swoop. alerts stays whole site.
      allow read: if canAccessWholeSite(siteId) ||
                     (canAccessSite(siteId) && settingId in ['swoop', 'display', 'cortex']);
      allow write: if isServiceAccount();
    }

    // ============================================
    // Chat Conversations Collection
    // ============================================

    match /chats/{chatId} {
      // AI chat conversations
      // Users can read their own chats OR autonomous chats for sites they have whole-site access to
      // a scoped member sees no autonomous chat: showing the ones about their machines
      // would take a targetMachineId index and a filtered list query.
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid ||
                      (resource.data.source == 'autonomous' &&
                       canAccessWholeSite(resource.data.siteId)));
      allow create: if isAuthenticated() &&
                     request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
                               resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        // Chat messages within a conversation
        // Access controlled by parent chat ownership OR autonomous chat whole-site access
        allow read: if isAuthenticated() &&
                       (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid ||
                        (get(/databases/$(database)/documents/chats/$(chatId)).data.source == 'autonomous' &&
                         canAccessWholeSite(get(/databases/$(database)/documents/chats/$(chatId)).data.siteId)));
        allow write: if isAuthenticated() &&
                        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
      }

      match /stream/{docId} {
        // Live turn snapshots for async Cortex turns (stream/current)
        // Read access mirrors messages: parent chat ownership OR autonomous chat whole-site access
        // Written only by the server-side turn runner via Admin SDK (no client writes)
        allow read: if isAuthenticated() &&
                       (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid ||
                        (get(/databases/$(database)/documents/chats/$(chatId)).data.source == 'autonomous' &&
                         canAccessWholeSite(get(/databases/$(database)/documents/chats/$(chatId)).data.siteId)));
      }
    }

    // ============================================
    // Cortex Follow-ups Collection
    // ============================================

    match /cortex-followups/{followupId} {
      // Scheduled Cortex follow-up reminders ("check back on a task")
      // Users can read their own follow-ups
      // Written only by trusted server APIs via Admin SDK (no client writes)
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // OAuth Token Collections (Server-Side Only)
    // ============================================

    match /agent_tokens/{tokenId} {
      // Registration codes for agent installer OAuth flow
      // SECURITY: Only accessible via server-side Admin SDK
      // Never allow client-side access (prevents token theft)
      allow read, write: if false;
    }

    match /agent_refresh_tokens/{tokenHash} {
      // Refresh tokens for agent authentication
      // SECURITY: Only accessible via server-side Admin SDK
      // Tokens are stored hashed for additional security
      allow read, write: if false;
    }

    match /device_codes/{phrase} {
      // Device code pairing phrases for device-code auth flow
      // SECURITY: Only accessible via server-side Admin SDK
      // Contains temporary tokens during pairing handshake
      allow read, write: if false;
    }

    // ============================================
    // Deny All Other Paths
    // ============================================

    // Explicitly deny access to any other documents
    // This prevents accidental data leaks
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

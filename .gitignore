# Environment / credentials
.env.test
.env.local
.env*.local

# Vercel CLI link metadata
.vercel

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg

# Pytest
.pytest_cache/
.pytest-tmp/
.pytest-basetemp*/

# Virtual environments
venv/
env/
ENV/
.venv/
agent/.venv/

# Dev planning artifacts
dev/completed/
dev/active/
dev/scratch/

# One-shot codex/claude prompts and transcripts. Loose dev/codex-* one-shots,
# raw .txt transcripts, and ad-hoc debug notes are scratch work and don't
# belong in the repo. .claude/codex-prompts/ is local-only prompt scratchpad.
dev/codex-*
dev/**/codex-*
dev/**/claude-*

# Ad-hoc multi-agent review/dispatch scratch — per-agent findings, briefings,
# prompts, raw stdout/patches, trigger payloads. Durable conclusions live in
# COMMITS; these one-off dispatches aren't committed.
#
# dev/findings-ledger.md is deliberately local-only too (see below), matching
# dev/active/ and dev/completed/. It holds accepted-risk security triage, which
# is not something to publish into repo history. This comment used to name it as
# the durable home for conclusions while the rule below ignored it — a
# contradiction resolved 2026-09-07 in favour of keeping it out of git.
dev/**/*-findings.md
dev/**/agent*.md
dev/**/BRIEFING.md
dev/**/_briefing.md
dev/**/_prompt-*
dev/**/*.out
dev/**/*.patch
dev/**/findings.md
dev/**/dryrun*.txt
dev/**/event.json
dev/**/issue.json
dev/findings-ledger.md
dev/whole-app-review-*.md
*.output.txt
.claude/codex-prompts/

# Playwright per-run output (artifacts, traces, videos)
test-results/
web/e2e/.output/

# IDE
.vscode/
.idea/
.claude/settings.local.json
.claude/session-edits.json
.claude/.env.local
.claude/memory/
.claude/plans/
.claude/worktrees/
.claude/scheduled_tasks.lock
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
!web/app/logs/
!web/app/api/sites/*/logs/
!web/app/api/sites/*/logs/route.ts
!web/e2e/specs/logs/
tmp/
agent/logs/
agent/tmp/

# Build artifacts
node_modules/
site/
# `site/` is the generated docs output at the repo root, but the pattern is
# unanchored and so swallows any directory named `site` at any depth — which
# silently hid the whole `/api/agent/site` route. Same collision, and same
# fix, as the `logs/` negations above.
!web/app/api/agent/site/
build/
dist/
/installer/
agent/build/
agent/build_log.txt
agent/build_output.txt
agent/dist/
agent/downloads/
agent/installer/
*.exe
*.msi
# ...except the third-party binaries we deliberately vendor so a build never
# depends on someone else's download host being up. (vendor/nssm-2.24.zip was
# the other one; 3.0.0 builds the service host from source in agent/host, so
# there is nothing left to download for it.)
!agent/vendor/MicrosoftEdgeWebview2Setup.exe
!agent/vendor/PawnIO_setup.exe

# Configuration files with secrets
client_secrets.json
config/config.json
config/app_states.json
agent/config/config.json
agent/config/app_states.json

# Firebase
.firebase-config/
firebase-credentials.json
config/firebase-credentials.json
config/firebase_cache.json
agent/config/firebase-creds-dev.json
agent/config/firebase-creds-prod.json
agent/config/firebase_cache.json

# Temporary/generated files
nul
*.spec.bak
hook-*.py
pywin32_postinstall.py
agent/hook-*.py
agent/pywin32_postinstall.py

# Backfill change logs — operational undo records containing uid↔site mappings.
# Keep them on disk (they are the only safe rollback source) but never commit.
scripts/*.log.json
scripts/migrations/*.log.json

# local credential files for other accounts (never commit)
.claude/.env.*
!.claude/.env.example

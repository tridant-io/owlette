{
  "version": 1,
  "note": "KeyboardEvent.code -> ps/2 set-1 scancode for SendInput with KEYEVENTF_SCANCODE. scancode is the low byte in decimal; extended:true means the 0xE0 prefix, i.e. add KEYEVENTF_EXTENDEDKEY. scancode:null means the key is not injected — see its note. the numpad and the control/arrow pad share low bytes and are told apart only by extended, which is why the host must key on code and never on the browser key value.",
  "scancodeEncoding": "ps2-set-1, low byte, decimal",
  "modifiers": "left and right modifiers are distinct codes and must stay distinct on the wire. a mac client sends MetaLeft/MetaRight for cmd; the viewer maps cmd to ControlLeft before it sends, so the host never guesses (plan.md owner requirement: cmd conversion).",
  "sequences": {
    "PrintScreen": {
      "make": [
        {
          "scancode": 42,
          "extended": true
        },
        {
          "scancode": 55,
          "extended": true
        }
      ],
      "break": [
        {
          "scancode": 55,
          "extended": true
        },
        {
          "scancode": 42,
          "extended": true
        }
      ],
      "note": "inject both halves on whichever edge arrives: chrome on windows reports PrintScreen on keyup only, and windows 11 may swallow it for the snipping tool before any app sees it."
    },
    "Pause": {
      "virtualKey": 19,
      "note": "the e1 prefix cannot be expressed through SendInput scancodes, so Pause is injected by virtual key VK_PAUSE. ctrl+pause is break, VK_CANCEL 0x03."
    }
  },

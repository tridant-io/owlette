// the owlette group may start, stop and restart the owlette service, and
// nothing else (tri-platform 5.2, plan decision 4): the desktop app's
// "restart service" runs as the console user, who is in the group, and
// systemd asks polkit for org.freedesktop.systemd1.manage-units on
// owlette-agent.service. every other unit, and every other action, keeps
// the default policy.
polkit.addRule(function (action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") === "owlette-agent.service" &&
      subject.isInGroup("owlette")) {
    var verb = action.lookup("verb");
    if (verb === "start" || verb === "stop" || verb === "restart") {
      return polkit.Result.YES;
    }
  }
});

# owlette swoop, the viewer app, in the app menu and as the handler of
# owlette-swoop:// links. build.sh ships this in place of the Tauri bundler's
# launcher: one menu entry, wearing owlette swoop's own icon (hicolor
# owlette-swoop-viewer, from its deb), the small eye beside owlette's full one.
[Desktop Entry]
Type=Application
Name=owlette swoop
Exec=owlette-swoop-viewer %u
Icon=owlette-swoop-viewer
Terminal=false
Categories=Utility;
MimeType=x-scheme-handler/owlette-swoop;

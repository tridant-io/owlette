<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  hardened-runtime entitlements for the bundled python runtime (tri-platform
  5.1). notarization requires the hardened runtime on every executable in the
  payload; python then needs these three or it cannot run: ctypes and cffi
  build call trampolines in writable memory (jit / unsigned executable
  memory), and extension modules and the interpreter's own dylibs are loaded
  with dlopen across the runtime (library validation off, so a module signed
  by us in a later release still loads next to this one).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
